/* 侧栏 */
.qq-side { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
.qq-panel {
  background: var(--qq-c-surface); border: 1px solid var(--qq-c-line);
  border-radius: var(--qq-r-md); padding: 18px; box-shadow: var(--qq-c-shadow);
}
.qq-panel__title { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--qq-c-text-3); margin-bottom: 12px; }

.qq-profile { text-align: center; }
.qq-profile__avatar {
  width: 76px; height: 76px; margin: 0 auto 12px; border-radius: 50%; object-fit: cover;
  border: 3px solid var(--qq-c-surface); box-shadow: 0 0 0 1px var(--qq-c-line), 0 10px 24px rgba(16, 20, 30, .14);
}
.qq-profile__name { font-size: 16px; }
.qq-profile__desc { margin-top: 6px; font-size: 12.5px; color: var(--qq-c-text-2); }
.qq-profile__live { margin-top: 10px; font-size: 12px; color: var(--qq-c-text-3); }

.qq-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; text-align: center; }
.qq-stats b { display: block; font-size: 18px; font-variant-numeric: tabular-nums; }
.qq-stats span { font-size: 11.5px; color: var(--qq-c-text-3); }

.qq-list li + li { border-top: 1px solid var(--qq-c-line); }
.qq-list a { display: flex; justify-content: space-between; padding: 8px 0; font-size: 13.5px; }
.qq-list a:hover { color: var(--qq-c-accent); }
.qq-list em { font-style: normal; font-size: 11.5px; color: var(--qq-c-text-3); }

.qq-tags { display: flex; flex-wrap: wrap; gap: 8px; }
.qq-tags a {
  padding: 3px 11px; border-radius: 999px; font-size: 12.5px;
  background: var(--qq-c-surface-2); border: 1px solid var(--qq-c-line); color: var(--qq-c-text-2);
  transition: all .2s;
}
.qq-tags a:hover { color: var(--qq-c-accent); border-color: var(--qq-c-accent); background: var(--qq-c-accent-soft); }

.qq-recent a { display: block; padding: 8px 0; font-size: 12.5px; }
.qq-recent li + li { border-top: 1px solid var(--qq-c-line); }
.qq-recent b { display: block; font-size: 13px; }
.qq-recent span { color: var(--qq-c-text-3); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

